{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Redis-Server",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/redis-server",
            "args": ["6379"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build server"
        },
        {
            "name": "Debug Redis-Client",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/redis-client",
            "args": ["-h", "127.0.0.1", "-p", "6379"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build client"
        }
    ],
    "compounds": []
}
